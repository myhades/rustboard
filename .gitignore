# Rust build output (keep Cargo.lock for reproducible application builds)
**/target/
**/*.rs.bk
/test-output/
*.log

# Local configuration and credentials
.env
.env.*
!.env.example

# Editor and operating-system metadata
.idea/
.vs/
*.user
*.suo
.DS_Store
Thumbs.db
Desktop.ini

# Native macOS build output and per-user Xcode state
/platforms/macos/native/build/
**/DerivedData/
**/xcuserdata/

# Python test helper bytecode
__pycache__/
*.py[cod]
