{
  "version": "0.1.0",
  "description": "Native clipboard synchronization with lazy file transfer",
  "homepage": "https://github.com/myhades/rustboard",
  "license": "MIT",
  "architecture": {
    "64bit": {
      "url": "https://github.com/myhades/rustboard/releases/download/v0.1.0/rustboard-0.1.0-windows-x64.zip",
      "hash": "b4c506d548d8c38253e4b3da03b8dac67dd6c1973b38048ef91ed4bb42600843"
    }
  },
  "bin": "bin/rustboard.exe",
  "pre_install": "if ($global) { throw 'Rustboard must be installed per user, without --global' }",
  "installer": {
    "script": "& \"$dir\\platforms\\windows\\scripts\\install.ps1\" -Source \"$dir\\bin\" -NoPath"
  },
  "uninstaller": {
    "script": "if ($cmd -eq \"uninstall\") { & \"$dir\\platforms\\windows\\scripts\\uninstall.ps1\" -Purge:$purge }"
  }
}
