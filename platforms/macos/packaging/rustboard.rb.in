# Generated by platforms/macos/scripts/package.py; local archives are for development only.
class Rustboard < Formula
  desc "Native clipboard synchronization with lazy file transfer"
  homepage "https://github.com/myhades/rustboard"
  url "@URL@"
  sha256 "@SHA256@"
  version "0.1.0"
  depends_on :macos
  def install
    bin.install "bin/rustboard", "bin/rustboardd"
    prefix.install "Rustboard.app"
  end
  def caveats
    <<~EOS
      The File Provider app must be installed and registered in the user's session.
      This formula deploys files; it does not bypass signing, notarization, or system approval.
      Follow docs/INSTALLATION.md for the native app and launchd installation.
    EOS
  end
  test do
    assert_match "rustboard 0.1.0", shell_output("#{bin}/rustboard --version")
  end
end
